<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug-only sample screens for visual review; no Bluetooth access. -->
        <activity
            android:name=".SampleActivity"
            android:exported="true"
            android:label="MoonMode samples">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="moonmode-sample" />
            </intent-filter>
        </activity>
        <!-- Debug-only RFCOMM session probe; reads and registrations only, never SET. -->
        <activity
            android:name=".RfcommProbeActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name=".WidgetCommandProbeActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".RfcommProbeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
