<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/st2_widget_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/st2_widget_button_corner" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/st2_widget_selected" />
                    <stroke android:width="2dp" android:color="@color/st2_widget_focus" />
                    <corners android:radius="@dimen/st2_widget_button_corner" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/st2_widget_selected" />
                    <corners android:radius="@dimen/st2_widget_button_corner" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
