<?xml version="1.0" encoding="utf-8"?>
<!-- Widget theme: solid glass panel (no blur in launcher widgets). Android 12–13 palette tones. -->
<resources>
    <color name="st2_widget_surface">@android:color/system_neutral1_100</color>
    <color name="st2_widget_on_surface">@android:color/system_neutral1_900</color>
    <color name="st2_widget_status">@android:color/system_neutral2_700</color>
    <color name="st2_widget_selected">@android:color/system_accent2_100</color>
    <color name="st2_widget_on_selected">@android:color/system_accent2_900</color>
    <!-- Lit rim: highlight at 85 % on top, outline-variant at 25 % at the bottom. -->
    <color name="st2_widget_rim_top">#D9FFFFFF</color>
    <color name="st2_widget_rim_bottom">#40B5B0BB</color>
</resources>
